{
  "name": "telegram-watchdog",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "start": "tsx src/server.ts",
    "dev:node": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t telegram-watchdog ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.38.3",
    "hono": "^4.10.6",
    "openai": "^6.9.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251117.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.4.0"
  }
}
